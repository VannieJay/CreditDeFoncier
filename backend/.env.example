# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database (Option A: single connection string, e.g. Supabase session pooler) ----
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true

# ---- Database (Option B: discrete variables) ----
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432
DB_SSL=true

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ---- CORS / Security ----
# Extra origins allowed to call the API. The serving host (same-origin
# frontend + API) is ALWAYS trusted automatically - list only external clients.
CORS_ORIGINS=https://portal.cdfoncier.online

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- Seed demo data on empty DB (never enable in production) ----
SEED=false